<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MenuProUI.Dialogs.AccessDialog"
        Width="760" Height="680"
        MinWidth="680" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Title="Acesso"
        CanResize="True">
  <Grid RowDefinitions="Auto,*,Auto" Margin="16" RowSpacing="12">
    <Border Classes="Card" Padding="14,12">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <Border Width="40" Height="40" CornerRadius="9" Background="#0F766E"
                VerticalAlignment="Center">
          <TextBlock Text="A" FontSize="16" FontWeight="Bold" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Dados do acesso" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="Configure a conexão e as opções específicas" FontSize="12" Foreground="#94A3B8"/>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12">
        <Border Classes="Card" Padding="16">
          <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="12" RowSpacing="10">
            <StackPanel>
              <TextBlock Text="Cliente" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
              <ComboBox Name="ClientBox" HorizontalAlignment="Stretch"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Tipo" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
              <ComboBox Name="TypeBox" SelectionChanged="OnTypeChanged" HorizontalAlignment="Stretch"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
              <TextBlock Text="Apelido" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
              <TextBox Name="AliasBox"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
              <TextBlock Text="Tags (opcional)" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
              <TextBox Name="TagsBox" Watermark="infra, producao, vpn"/>
            </StackPanel>
          </Grid>
        </Border>

        <Border Classes="Card" Padding="16">
          <StackPanel Spacing="12">
            <TextBlock Text="Conexão" FontSize="15" FontWeight="SemiBold"/>

            <StackPanel Name="PanelSshRdp" Spacing="12">
              <Grid ColumnDefinitions="*,140" ColumnSpacing="12">
                <StackPanel>
                  <TextBlock Text="Host" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                  <TextBox Name="HostBox"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Porta" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                  <TextBox Name="PortBox"/>
                </StackPanel>
              </Grid>

              <StackPanel>
                <TextBlock Text="Usuário" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                <TextBox Name="UserBox"/>
              </StackPanel>

              <StackPanel Name="PanelRdp" Spacing="12">
                <Border BorderBrush="#263244" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                  <StackPanel Spacing="12">
                    <TextBlock Text="Opções RDP" FontSize="14" FontWeight="SemiBold"/>
                    <StackPanel>
                      <TextBlock Text="Domínio (opcional)" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                      <TextBox Name="DomainBox" Watermark="EX: CONTOSO"/>
                    </StackPanel>
                    <StackPanel Spacing="6">
                      <CheckBox Name="IgnoreCertBox" Content="Aceitar certificado inválido (cert:ignore)" />
                      <CheckBox Name="DynamicResBox" Content="Redimensionamento dinâmico (dynamic-resolution)" />
                      <CheckBox Name="FullScreenBox" Content="Tela cheia (f)" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                      <StackPanel>
                        <TextBlock Text="Largura fixa" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                        <TextBox Name="WidthBox" Watermark="Ex: 1366"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="Altura fixa" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                        <TextBox Name="HeightBox" Watermark="Ex: 768"/>
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>

            <StackPanel Name="PanelUrl" Spacing="10">
              <TextBlock Text="URL" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1"/>
              <TextBox Name="UrlBox" Watermark="https://firewall.local:4444"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Name="TestUrlButton" Content="Testar URL" Click="OnTestUrl"/>
                <TextBlock Name="UrlTestResultText" Text="" Foreground="#94A3B8"
                           VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="Card" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="Detalhes adicionais" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="Observações" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1"/>
            <TextBox Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="110"/>
            <CheckBox Name="FavoriteBox" Content="Marcar como favorito" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Classes="Card" Padding="10">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="Cancelar" Click="OnCancel"/>
        <Button Content="Salvar acesso" Classes="accent" Click="OnSave"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
