<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MenuProUI.Dialogs.ClientDialog"
        Width="560" Height="360"
        WindowStartupLocation="CenterOwner"
        Title="Cliente"
        CanResize="False">

  <Border BorderBrush="#333" BorderThickness="1" CornerRadius="8" Margin="8" Padding="16">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="10">

    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
      <Border Width="34" Height="34" CornerRadius="17" BorderBrush="#333" BorderThickness="1">
        <TextBlock Text="♟" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <TextBlock Text="Dados do Cliente" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </StackPanel>

    <TextBlock Grid.Row="1" Text="Nome do Cliente" />
    <TextBox Grid.Row="2" Name="NameBox"/>

    <TextBlock Grid.Row="3" Text="Observações" />

    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Height="160">
      <TextBox Name="NotesBox"
               AcceptsReturn="True"
               TextWrapping="Wrap"/>
    </ScrollViewer>

    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
      <Button Content="Cancelar" Click="OnCancel"/>
      <Button Content="Salvar" Click="OnSave"/>
    </StackPanel>

  </Grid>
  </Border>
</Window>
