<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fluent="clr-namespace:Avalonia.Themes.Fluent;assembly=Avalonia.Themes.Fluent"
             x:Class="MenuProUI.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <fluent:FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

    <Style Selector="Window">
      <Setter Property="Background" Value="#0B1120"/>
      <Setter Property="Foreground" Value="#E5E7EB"/>
      <Setter Property="FontFamily" Value="Inter"/>
    </Style>

    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#2563EB"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="MinHeight" Value="38"/>
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="MinHeight" Value="38"/>
    </Style>

    <Style Selector="Border.Card">
      <Setter Property="Background" Value="#111827"/>
      <Setter Property="BorderBrush" Value="#263244"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <Style Selector="Border.SectionHeader">
      <Setter Property="Background" Value="#151F30"/>
      <Setter Property="BorderBrush" Value="#263244"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="CornerRadius" Value="12,12,0,0"/>
    </Style>

    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="7,6"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Margin" Value="0,1"/>
    </Style>

    <Style Selector="DataGrid">
      <Setter Property="Background" Value="#0F1726"/>
      <Setter Property="RowBackground" Value="#0F1726"/>
      <Setter Property="Foreground" Value="#E5E7EB"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="#172033"/>
      <Setter Property="Foreground" Value="#AEB8C7"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="10,9"/>
    </Style>
  </Application.Styles>
</Application>
