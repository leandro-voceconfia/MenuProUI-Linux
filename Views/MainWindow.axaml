<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="MenuProUI.Views.MainWindow"
        Width="1320" Height="760"
        MinWidth="960" MinHeight="620"
        Title="MenuProUI"
        Icon="avares://MenuProUI/Assets/icon-256.png"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">

  <Grid ColumnDefinitions="300,*" RowDefinitions="Auto,*,Auto" Margin="16" RowSpacing="14" ColumnSpacing="14">

    <!-- Header -->
    <Border Grid.ColumnSpan="2" Classes="Card" Padding="12,10">
      <Grid ColumnDefinitions="220,*,Auto" ColumnSpacing="12">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Width="38" Height="38" CornerRadius="9" Background="#2563EB">
            <TextBlock Text="M" FontSize="18" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="MenuPro" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Centro de acessos" FontSize="11" Foreground="#94A3B8"/>
          </StackPanel>
        </StackPanel>

        <TextBox Grid.Column="1"
                 Name="GlobalSearchBox"
                 Watermark="Buscar em clientes e acessos..."
                 Text="{Binding GlobalSearchText}"
                 MaxWidth="520"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Center"/>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Border CornerRadius="7" Padding="10,7" Background="#172033" VerticalAlignment="Center">
            <TextBlock Name="AuditIntegrityText" Text="Auditoria: verificando..." FontSize="12" Foreground="#CBD5E1"/>
          </Border>
          <Button Name="ClientsMenuBtn" Content="Clientes" ToolTip.Tip="Menu de Clientes"/>
          <Button Name="AccessesMenuBtn" Content="Acessos" ToolTip.Tip="Menu de Acessos"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Context menus as popup -->
    <Popup Name="ClientsMenu" IsOpen="False" IsLightDismissEnabled="True" PlacementTarget="{Binding #ClientsMenuBtn}">
      <Border Background="#1e1e1e" BorderBrush="#333" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="190">
        <StackPanel Spacing="0">
          <Button Click="OnNewClient" Padding="12,9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" Foreground="White">
            <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Width="20" Text="✚" Foreground="White"/><TextBlock Text="Novo Cliente" Foreground="White"/></StackPanel>
          </Button>
          <Border BorderBrush="#333" BorderThickness="0,1,0,0" Margin="8,2"/>
          <Button Click="OnEditClient" Padding="12,9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" Foreground="White">
            <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Width="20" Text="✎" Foreground="White"/><TextBlock Text="Editar Cliente" Foreground="White"/></StackPanel>
          </Button>
          <Border BorderBrush="#333" BorderThickness="0,1,0,0" Margin="8,2"/>
          <Button Click="OnDeleteClient" Padding="12,9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" Foreground="White">
            <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Width="20" Text="✕" Foreground="White"/><TextBlock Text="Excluir Cliente" Foreground="White"/></StackPanel>
          </Button>
          <Border BorderBrush="#333" BorderThickness="0,1,0,0" Margin="8,2"/>
          <Button Click="OnExportDataClick" Padding="12,9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" Foreground="White">
            <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Width="20" Text="⇧" Foreground="White"/><TextBlock Text="Exportar CSVs" Foreground="White"/></StackPanel>
          </Button>
          <Border BorderBrush="#333" BorderThickness="0,1,0,0" Margin="8,2"/>
          <Button Click="OnImportDataClick" Padding="12,9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" Foreground="White">
            <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Width="20" Text="⇩" Foreground="White"/><TextBlock Text="Importar CSVs" Foreground="White"/></StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </Popup>

    <Popup Name="AccessesMenu" IsOpen="False" IsLightDismissEnabled="True" PlacementTarget="{Binding #AccessesMenuBtn}">
      <Border Background="#1e1e1e" BorderBrush="#333" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="210">
        <StackPanel Spacing="0">
          <Button Click="OnNewAccess" Padding="12,9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" Foreground="White">
            <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Width="20" Text="✚" Foreground="White"/><TextBlock Text="Novo Acesso" Foreground="White"/></StackPanel>
          </Button>
          <Border BorderBrush="#333" BorderThickness="0,1,0,0" Margin="8,2"/>
          <Button Click="OnCloneAccess" Padding="12,9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" Foreground="White">
            <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Width="20" Text="⧉" Foreground="White"/><TextBlock Text="Clonar Acesso" Foreground="White"/></StackPanel>
          </Button>
          <Border BorderBrush="#333" BorderThickness="0,1,0,0" Margin="8,2"/>
          <Button Click="OnEditAccess" Padding="12,9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" Foreground="White">
            <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Width="20" Text="✎" Foreground="White"/><TextBlock Text="Editar Acesso" Foreground="White"/></StackPanel>
          </Button>
          <Border BorderBrush="#333" BorderThickness="0,1,0,0" Margin="8,2"/>
          <Button Click="OnDeleteAccess" Padding="12,9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" Foreground="White">
            <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Width="20" Text="✕" Foreground="White"/><TextBlock Text="Excluir Acesso" Foreground="White"/></StackPanel>
          </Button>
          <Border BorderBrush="#333" BorderThickness="0,1,0,0" Margin="8,2"/>
          <Button Click="OnToggleFavoriteClick" Padding="12,9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" Foreground="White">
            <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Width="20" Text="★" Foreground="White"/><TextBlock Text="Favoritar/Desfavoritar" Foreground="White"/></StackPanel>
          </Button>
          <Border BorderBrush="#333" BorderThickness="0,1,0,0" Margin="8,2"/>
          <Button Click="OnShowAuditClick" Padding="12,9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" Foreground="White">
            <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Width="20" Text="≡" Foreground="White"/><TextBlock Text="Ver Auditoria" Foreground="White"/></StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </Popup>

    <!-- Clients -->
    <Border Grid.Row="1" Grid.Column="0" Classes="Card" Padding="12">
      <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" RowSpacing="10">
        
        <!-- Header with counter -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <Border Width="34" Height="34" CornerRadius="8" Background="#1D4ED8" VerticalAlignment="Center">
            <TextBlock Text="C" FontSize="14" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Clientes" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Organizações cadastradas" FontSize="11" Foreground="#94A3B8"/>
          </StackPanel>
          <Border Grid.Column="2" CornerRadius="12" Padding="8,4" Background="#172033" VerticalAlignment="Center">
            <TextBlock Text="{Binding ClientsFilteredCount, StringFormat={}{0}}" FontSize="12" Foreground="#CBD5E1"/>
          </Border>
        </Grid>

        <!-- Search box -->
        <TextBox Grid.Row="1" 
                 Name="ClientsSearchBox"
                 Watermark="🔍 Buscar cliente..."
                 Text="{Binding ClientsSearchText}"
                 Padding="10,8" BorderBrush="#263244"/>

        <!-- Clients list filtered -->
        <ListBox Grid.Row="2" Name="ClientsList"
                 ItemsSource="{Binding ClientsFiltered}"
                 SelectedItem="{Binding SelectedClient}"
                 SelectionChanged="OnClientSelectionChanged">
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Novo Cliente" Click="OnNewClient"/>
              <MenuItem Header="Editar Cliente" Click="OnEditClient"/>
              <MenuItem Header="Excluir Cliente" Click="OnDeleteClient"/>
            </ContextMenu>
          </ListBox.ContextMenu>

          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Padding="7,5" CornerRadius="7">
                <Grid ColumnDefinitions="32,*">
                  <TextBlock Grid.Column="0"
                             Text="{Binding ConnectivityBadge}"
                             Foreground="{Binding ConnectivityBadgeColor}"
                             FontSize="16"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{Binding Nome}" TextTrimming="CharacterEllipsis"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="3" BorderBrush="#263244" BorderThickness="0,1,0,0" Margin="0,4,0,2"/>
        <TextBlock Grid.Row="4" Text="Dados locais" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
        <TextBlock Grid.Row="5" Text="{Binding ClientsPath}" Foreground="#64748B" FontSize="10"
                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ClientsPath}"/>
      </Grid>
    </Border>

    <!-- Accesses -->
    <Border Grid.Row="1" Grid.Column="1" Classes="Card" Padding="12">
      <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">

        <!-- Header with counter -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <Border Width="34" Height="34" CornerRadius="8" Background="#0F766E" VerticalAlignment="Center">
            <TextBlock Text="A" FontSize="14" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Acessos" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding AccessesCountDisplay, StringFormat={}{0} registros}" FontSize="11" Foreground="#94A3B8"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Content="Abrir" Classes="accent" Click="OnOpenAccess" ToolTip.Tip="Abrir acesso selecionado (Enter)"/>
            <Button Content="Conectividade" Click="OnCheckConnectivity" ToolTip.Tip="Checar conectividade (Ctrl+Shift+K)"/>
            <Button Content="Atualizar" Click="OnReload" ToolTip.Tip="Recarregar dados"/>
            <Button Content="Configurações" Click="OnSettingsClick" ToolTip.Tip="Abrir configurações (Ctrl+Shift+S)"/>
          </StackPanel>
        </Grid>

        <!-- Search box for accesses -->
        <TextBox Grid.Row="1"
                 Name="AccessesSearchBox"
                 Watermark="🔍 Buscar acesso..."
                 Text="{Binding AccessesSearchText}"
                 Padding="10,8" BorderBrush="#263244"/>

        <!-- Accesses grid (colunas redimensionáveis) -->
        <DataGrid Grid.Row="2"
                  Name="AccessList"
                  ItemsSource="{Binding AccessesFiltered}"
                  SelectedItem="{Binding SelectedAccess}"
                  SelectionChanged="OnAccessSelectionChanged"
                  DoubleTapped="OnOpenAccess"
                  AutoGenerateColumns="False"
                  ColumnWidth="150"
                  MinColumnWidth="70"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="All"
                  HeadersVisibility="Column"
                  IsReadOnly="True">
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Abrir" Click="OnOpenAccess"/>
              <MenuItem Header="Favoritar/Desfavoritar" Click="OnToggleFavoriteClick"/>
              <MenuItem Header="Clonar" Click="OnCloneAccess"/>
              <MenuItem Header="Editar" Click="OnEditAccess"/>
              <MenuItem Header="Excluir" Click="OnDeleteAccess"/>
            </ContextMenu>
          </DataGrid.ContextMenu>

          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Net" Width="70" MinWidth="60" CanUserResize="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding ConnectivityBadge}"
                             Foreground="{Binding ConnectivityBadgeColor}"
                             FontSize="16"
                             HorizontalAlignment="Center"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Fav" Binding="{Binding FavoriteBadge}" Width="70" MinWidth="60" CanUserResize="True"/>
            <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="120" MinWidth="90" CanUserResize="True"/>
            <DataGridTextColumn Header="Apelido" Binding="{Binding ApelidoDisplay}" Width="220" MinWidth="140" CanUserResize="True"/>
            <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="220" MinWidth="140" CanUserResize="True"/>
            <DataGridTextColumn Header="Porta" Binding="{Binding Porta}" Width="90" MinWidth="80" CanUserResize="True"/>
            <DataGridTextColumn Header="Usuário" Binding="{Binding Usuario}" Width="180" MinWidth="120" CanUserResize="True"/>
            <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="260" MinWidth="180" CanUserResize="True"/>
          </DataGrid.Columns>
        </DataGrid>

      </Grid>
    </Border>

    <!-- Footer -->
    <Border Grid.Row="2" Grid.ColumnSpan="2" Classes="Card" Padding="10,7">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Name="AppVersionText"
                   Grid.Column="0"
                   Text="Versão: -"
                   Foreground="#94A3B8"
                   FontSize="12"
                   VerticalAlignment="Center"/>
        <Border Grid.Column="1" Width="1" Height="16" Margin="14,0" Background="#263244"
                HorizontalAlignment="Left"/>
        <TextBlock Name="ConnectivityStatusText"
                   Grid.Column="2"
                   Text="Conectividade: aguardando checagem"
                   HorizontalAlignment="Right"
                   Foreground="#CBD5E1"
                   FontSize="12"
                   VerticalAlignment="Center"/>
      </Grid>
    </Border>

  </Grid>
</Window>
